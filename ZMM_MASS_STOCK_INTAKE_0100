*&---------------------------------------------------------------------*
*&  Include           ZMM_MASS_STOCK_INTAKE_0100
*&  Screen 0100 — ALV output log
*&  Screen must contain a custom container CC_ALV covering the grid area.
*&---------------------------------------------------------------------*

*&---------------------------------------------------------------------*
*& Module STATUS_0100 OUTPUT (PBO)
*&---------------------------------------------------------------------*
MODULE status_0100 OUTPUT.
  SET PF-STATUS 'STATUS_0100'.
  SET TITLEBAR  'TITLE_0100'.

  DATA(lo_main) = lcl_main=>get_instance( ).
  lo_main->display_alv( ).
ENDMODULE.

*&---------------------------------------------------------------------*
*& Module USER_COMMAND_0100 INPUT (PAI)
*&---------------------------------------------------------------------*
MODULE user_command_0100 INPUT.
  CASE sy-ucomm.
    WHEN 'BACK'.
      LEAVE TO SCREEN 0.
    WHEN 'RETURN' OR 'EXIT'.
      LEAVE PROGRAM.
    WHEN 'DWNLD'.
      " Download error log as CSV
      DATA(lt_errors) = FILTER #( gt_log USING WHERE status = 'E' ).
      IF lt_errors IS INITIAL.
        MESSAGE 'No error rows to download.' TYPE 'I'.
      ELSE.
        DATA lt_csv TYPE TABLE OF string.
        APPEND 'ROW_NR;MATNR;QTY;SITE;SLOC;VERPR;MESSAGE' TO lt_csv.
        LOOP AT lt_errors INTO DATA(ls_err).
          APPEND |{ ls_err-row_nr };{ ls_err-matnr };{ ls_err-qty };{ ls_err-site };{ ls_err-sloc };{ ls_err-verpr };{ ls_err-message }|
            TO lt_csv.
        ENDLOOP.
        CALL FUNCTION 'GUI_DOWNLOAD'
          EXPORTING
            filename = 'C:\Temp\mass_stock_intake_errors.csv'
            filetype = 'ASC'
          TABLES
            data_tab = lt_csv
          EXCEPTIONS
            OTHERS   = 1.
        IF sy-subrc = 0.
          MESSAGE 'Error log downloaded to C:\Temp\mass_stock_intake_errors.csv' TYPE 'I'.
        ENDIF.
      ENDIF.
  ENDCASE.
ENDMODULE.
