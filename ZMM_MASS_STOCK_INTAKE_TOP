*&======================================================================*
*&  Include  ZMM_MASS_STOCK_INTAKE_TOP
*&  Global type definitions, constants, and data declarations.
*&  NOTE: No INITIALIZATION block here — only one is allowed per program.
*&        gs_stable is initialised in the main report INITIALIZATION.
*&======================================================================*

" Forward declaration so lcl_main can be referenced in DATA statements.
CLASS lcl_main DEFINITION DEFERRED.

" -----------------------------------------------------------------------
"  TYPES
" -----------------------------------------------------------------------

" One row as parsed from the CSV / XLSX input file.
" Field names match the spec column names (Section 3).
TYPES: BEGIN OF ty_upload_row,
         row_nr  TYPE i,          " Row number in the source file (for error messages)
         matnr   TYPE matnr,      " Material number -- 18-digit internal format
         qty     TYPE menge_d,    " Quantity to post; must be > 0
         site    TYPE werks_d,    " Plant / Site (e.g. 1643)
         sloc    TYPE lgort_d,    " Storage location within the plant
         verpr   TYPE verpr,      " Cost price of the incoming goods
       END OF ty_upload_row.

TYPES: ty_upload_tab TYPE STANDARD TABLE OF ty_upload_row WITH DEFAULT KEY.

" Status field length.  Fixed char so it can be coloured in the ALV.
TYPES: ty_status TYPE c LENGTH 20.

" One ALV output row -- one per upload row regardless of success/failure.
" Spec reference: Section 6.
TYPES: BEGIN OF ty_alv_row,
         row_nr   TYPE i,              " Source row number from the file
         matnr    TYPE matnr,          " Material number (display format, no leading zeros)
         maktx    TYPE maktx,          " Material short description
         qty      TYPE menge_d,        " Quantity from upload
         meins    TYPE meins,          " Base unit of measure from MARA
         site     TYPE werks_d,        " Plant
         sloc     TYPE lgort_d,        " Storage location
         verpr    TYPE verpr,          " Cost price passed in upload
         pric_ctl TYPE mbew-vprsv,     " Price control: S = Standard, V = Moving Average
         status   TYPE ty_status,      " Posted / Simulated / Error / Warning
         matdoc   TYPE mblnr,          " Material document number (live mode only)
         message  TYPE string,         " Combined info / warning / error text for this row
         scol     TYPE lvc_t_scol,     " Row colour (set by set_row_color method)
       END OF ty_alv_row.

TYPES: ty_alv_tab TYPE STANDARD TABLE OF ty_alv_row WITH DEFAULT KEY.

" -----------------------------------------------------------------------
"  STATUS TEXT CONSTANTS
"  Displayed in the ALV STATUS column (Section 6).
" -----------------------------------------------------------------------
CONSTANTS: mc_status_posted TYPE ty_status VALUE 'Posted',
           mc_status_sim    TYPE ty_status VALUE 'Simulated',
           mc_status_error  TYPE ty_status VALUE 'Error',
           mc_status_warn   TYPE ty_status VALUE 'Warning'.

" -----------------------------------------------------------------------
"  VERPR DEVIATION TOLERANCE  (Section 5.2, row 9 -- Open Point #3)
"  Recommended threshold is 50%. Change this constant once confirmed.
" -----------------------------------------------------------------------
CONSTANTS: mc_deviation_pct TYPE p DECIMALS 2 VALUE '50.00'.

" -----------------------------------------------------------------------
"  GLOBAL OBJECTS / DATA
" -----------------------------------------------------------------------
DATA: go_main   TYPE REF TO lcl_main.  " Singleton instance of the main class
DATA: gs_stable TYPE lvc_s_stbl.       " Stable-scroll flags for ALV refresh
