*&======================================================================*
*&  Include  ZMM_MASS_STOCK_INTAKE_ALV
*&  Screen 0100 PBO / PAI modules for the ALV output.
*&  Spec reference: Section 6 (ALV Output Log).
*&======================================================================*

*&---------------------------------------------------------------------*
*&      Module  STATUS_0100  OUTPUT  (PBO)
*&---------------------------------------------------------------------*
MODULE status_0100 OUTPUT.
  SET PF-STATUS 'STATUS_0100'.
  SET TITLEBAR  'TITLE_0100'.

  IF p_test = abap_true.
    MESSAGE s398(00) WITH
      'SIMULATION MODE ACTIVE -- NO POSTINGS HAVE BEEN MADE'
      DISPLAY LIKE 'W'.
  ENDIF.

  go_main->display_alv( ).
ENDMODULE.

*&---------------------------------------------------------------------*
*&      Module  USER_COMMAND_0100  INPUT  (PAI)
*&---------------------------------------------------------------------*
MODULE user_command_0100 INPUT.
  CASE sy-ucomm.
    WHEN 'BACK'.
      LEAVE TO SCREEN 0.
    WHEN 'RETURN' OR 'EXIT' OR 'CANCEL'.
      LEAVE PROGRAM.
  ENDCASE.
ENDMODULE.
